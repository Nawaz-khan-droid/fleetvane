# ============================================
# FleetVane - Environment Variable Template
# Copy to .env and insert your real credentials
# ============================================

# --- Supabase ---
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_JWKS_URL=https://<your-project>.supabase.co/auth/v1/.well-known/jwks.json

# --- Spring Boot JPA (PostgreSQL via Supabase) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<your-project>
SPRING_DATASOURCE_PASSWORD=your_db_password

# --- JWT ---
JWT_SECRET=your_base64_secret_key_minimum_256_bits

# --- Google Maps ---
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
