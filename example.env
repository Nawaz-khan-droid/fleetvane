# ============================================
# FleetVane - Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================

# --- Supabase ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- Spring Boot JPA (PostgreSQL via Supabase) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-supabase-db-password

# --- JWT ---
JWT_SECRET=change-me-to-a-random-256-bit-string

# --- Google Maps ---
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
