# ============================================
# FleetVane — Environment Variable Template
# Copy to .env and insert real credentials.
# NEVER commit the real .env file.
# ============================================

# --- Spring Boot (backend process env) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password
JWT_SECRET=your_base64_or_random_string_min_32_bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: auth rate limiting (defaults shown)
# FLEETVANE_RATELIMIT_ENABLED=true
# FLEETVANE_RATELIMIT_CAPACITY=20
# FLEETVANE_RATELIMIT_REFILLMINUTES=1

# --- Next.js frontend (build-time inlined, PUBLIC values only) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_SPRING_BOOT_URL=http://localhost:8080
